APP_ENV=development
APP_NAME=MASTERY
API_V1_PREFIX=/api/v1

FRONTEND_URL=http://localhost:5173

# Database configuration (PostgreSQL / Supabase Postgres)
# Example: postgresql://postgres:password@localhost:5432/mastery
DATABASE_URL=

# Supabase Auth and Storage Integration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API Configuration (Required for AI generation modules)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LOG_LEVEL=INFO
